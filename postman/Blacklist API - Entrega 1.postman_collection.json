    {
      "name": "GET /blacklists/{email}",
      "item": [
        {
          "name": "Email que sí está en la lista negra",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"is_blacklisted es true\", () => pm.expect(body.is_blacklisted).to.eql(true));",
                  "pm.test(\"Devuelve el email consultado\", () => pm.expect(body.email).to.eql(pm.collectionVariables.get(\"listed_email\")));",
                  "pm.test(\"Devuelve el motivo guardado\", () => pm.expect(body.blocked_reason).to.eql(pm.collectionVariables.get(\"listed_reason\")));",
                  "pm.test(\"Responde en menos de 2 segundos\", () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/blacklists/{{listed_email}}",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "blacklists",
                "{{listed_email}}"
              ]
            },
            "description": "Consulta si un email está en la lista negra global y el motivo por el que fue agregado. La consulta no distingue mayúsculas de minúsculas.\n\n**Autorización:** Bearer Token estático.\n\n**Respuestas:** `200` con `email`, `is_blacklisted` (booleano) y `blocked_reason` (texto o null), `401` token ausente o inválido.\n\nUsa el email agregado en la primera solicitud del POST, por eso el orden de la colección importa."
          },
          "response": [
            {
              "name": "200 OK - en la lista",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{BASE_URL}}/blacklists/{{listed_email}}",
                  "host": [
                    "{{BASE_URL}}"
                  ],
                  "path": [
                    "blacklists",
                    "{{listed_email}}"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"email\": \"qa.1760000000000@example.com\",\n  \"is_blacklisted\": true,\n  \"blocked_reason\": \"Spam reportado desde la prueba automatizada\"\n}"
            }
          ]
        },
