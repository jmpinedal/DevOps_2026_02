                "url": {
                  "raw": "{{BASE_URL}}/blacklists",
                  "host": [
                    "{{BASE_URL}}"
                  ],
                  "path": [
                    "blacklists"
                  ]
                }
              },
              "status": "Created",
              "code": 201,
