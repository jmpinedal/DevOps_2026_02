                  "pm.test(\"is_blacklisted es true aunque el email vaya en mayúsculas\", () => pm.expect(body.is_blacklisted).to.eql(true));",
                  "pm.test(\"Devuelve el email normalizado en minúsculas\", () => pm.expect(body.email).to.eql(pm.collectionVariables.get(\"listed_email\")));"
                ]
              }
            }
          ],
